# Copy to .env.local. Everything here is optional for local development.
# Without Blob credentials, pictures are stored in ./.uploads

# Your public origin. Used for canonical URLs, preview images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob. Added for you when you connect a Blob store to a Vercel project.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Set to "public" only if your Blob store is public. Default is private.
# BLOB_ACCESS=private

# Moderation
# ADMIN_TOKEN=            # 16+ random characters; without it the admin routes return 404
# REPORT_THRESHOLD=3      # different reporters needed to auto-delete a picture
# REPORT_SALT=            # random string; set your own, the default is public in the source

# Where local pictures go when Blob isn't configured
# UPLOAD_DIR=

# Links in the "Dev's contact" dialog. Empty entries are hidden.
# NEXT_PUBLIC_CONTACT_X=
# NEXT_PUBLIC_CONTACT_GITHUB=
# NEXT_PUBLIC_CONTACT_LINKEDIN=
# NEXT_PUBLIC_CONTACT_INSTAGRAM=
